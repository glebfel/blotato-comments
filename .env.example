# HTTP
HOST=0.0.0.0
PORT=3000

# Storage: "memory" (default, no DB needed) or "postgres"
STORAGE=memory
DATABASE_URL=postgres://postgres:postgres@localhost:5432/blotato_comments

# DEMO_MODE=true seeds an in-memory workspace + simulated platforms so the API can be tried with curl
# (API key "demo"). With DEMO_MODE=false, API keys come from API_KEYS="key:workspaceId,key2:workspaceId2".
DEMO_MODE=true
API_KEYS=

LOG_LEVEL=info

# Background poller that re-syncs comments for published posts (see docs/DESIGN.md, "Sync")
SYNC_POLLER_ENABLED=true
SYNC_POLLER_INTERVAL_MS=15000
SYNC_POLLER_BATCH_SIZE=20
SYNC_POLLER_CONCURRENCY=4

# Sync behaviour (defaults shown; see CommentSyncService for what each one bounds)
SYNC_MAX_REQUESTS_PER_RUN=20
SYNC_LEASE_MS=300000
SYNC_MANUAL_COOLDOWN_MS=15000
SYNC_RECONCILE_AFTER_MS=60000
SYNC_GIVE_UP_AFTER_MS=600000
SYNC_PAUSED_RETRY_MS=86400000
SYNC_BACKGROUND_CONCURRENCY=4
SYNC_STALE_AFTER_MS=120000
SYNC_STALE_MAX_MS=3600000

# Timeout for calls to platform APIs
PLATFORM_HTTP_TIMEOUT_MS=10000

# Per-workspace rate limits (requests per minute)
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_SYNC_PER_MINUTE=10
RATE_LIMIT_REPLY_PER_MINUTE=60

# Platform credentials for the real adapters (only needed when DEMO_MODE=false).
# In production these live encrypted per social account, not in env vars; see DESIGN.md.
TWITTER_ACCESS_TOKEN=
YOUTUBE_ACCESS_TOKEN=
